# Copy to .env and fill in. Never commit .env.

# LLM provider (Anthropic). Without a key the app runs in deterministic rules-only mode.
ANTHROPIC_API_KEY=
MODEL_NAME=claude-opus-5-5
MODEL_EFFORT=low
# Server-side refusal fallback (beta). Set to 0 if your account/proxy rejects it.
ANTHROPIC_SERVER_FALLBACKS=1

# Local mock vendor-risk service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
VENDOR_RISK_TIMEOUT_SECONDS=3
# Start the mock API in-process when it is not running (eval scripts / handle_request).
MOCK_API_AUTOSTART=1
